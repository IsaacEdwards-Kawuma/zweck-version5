# Local development — copy to server/.env and adjust
DATABASE_URL="postgresql://user:password@localhost:5432/zweckos"
# Neon: postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Prisma migrations on Neon should use a direct (non-pooler) URL:
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

JWT_SECRET="your-secret-key-here"
PORT=3001

# Temporary: skip JWT on all /api/* routes (uses first user in DB, or placeholder). Never enable in production.
# AUTH_DISABLED=true

# CORS (local): only needed when NODE_ENV=production (e.g. testing prod build).
# With NODE_ENV unset or "development", the API allows any origin for easier local dev.
# If you use NODE_ENV=production locally, add every Origin you use, e.g.:
# ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://[::1]:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Logging (optional): debug | info | warn | error | silent
# LOG_LEVEL=info

# Rate limits (optional, per 15 minutes)
# RATE_LIMIT_API_MAX=500
# RATE_LIMIT_LOGIN_MAX=30
# RATE_LIMIT_FORGOT_PASSWORD_MAX=5

# Password reset emails: base URL for links (production). Falls back to CLIENT_ORIGIN if unset.
# PUBLIC_APP_URL=https://your-app.vercel.app

# SMTP (optional — without it, reset links are only logged to stdout in dev)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@example.com
#   ^ use a plain address in dashboards; "Name <email>" works in .env files but some hosts choke on < >

# Sentry (optional)
# SENTRY_DSN=https://...@sentry.io/...

# Optional: S3-compatible storage for director avatars (otherwise files stay on local disk).
# Set all of these to use object storage (AWS S3, Cloudflare R2, MinIO, etc.):
# S3_BUCKET=your-bucket
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# S3_PUBLIC_BASE_URL=https://your-bucket.s3.amazonaws.com
# For R2/MinIO, also set:
# S3_ENDPOINT=https://xxxx.r2.cloudflarestorage.com

# --- Production (Render) — same keys; see server/.env.render.example & RENDER_SETTINGS.md ---
# NODE_ENV=production
# DATABASE_URL=<Neon URL with ?sslmode=require>
# JWT_SECRET=<openssl rand -hex 32>
# ALLOWED_ORIGINS=https://your-app.vercel.app
# CLIENT_ORIGIN=https://your-app.vercel.app
# ALLOW_VERCEL_PREVIEWS=true

