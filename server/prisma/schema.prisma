generator client {
  provider = "prisma-client-js"
}

// Use Neon, local Postgres, or any Postgres. Neon: append ?sslmode=require to DATABASE_URL.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Director {
  id          Int       @id @default(autoincrement())
  name        String
  initials    String    @db.VarChar(3)
  email       String    @unique
  phone       String?
  idNumber    String?
  occupation  String?
  address     String?
  nextOfKinName  String?
  nextOfKinPhone String?
  notes       String?
  avatarUrl   String?
  joinedRound Int       @default(1)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  transactions Transaction[]
  user         User?
  assignedTasks ProjectTask[]
  ledProjects   Project[]     @relation("ProjectLeader")
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  role       Role      @default(USER)
  directorId Int?      @unique
  director   Director? @relation(fields: [directorId], references: [id])
  lastLoginAt DateTime?
  /** When true, user may receive meeting reminder emails (admins, directors, and meeting creator). */
  emailMeetingReminders Boolean @default(true)
  /** When true, user receives in-app notifications for meeting reminders (same audience rules as email). */
  inAppMeetingReminders Boolean @default(true)
  /** When true, user receives in-app notifications for new chat messages (bell/inbox). */
  inAppChatMessages Boolean @default(true)
  createdAt  DateTime  @default(now())

  notifications Notification[]
  chatRoomMembers ChatRoomMember[]
  chatRoomsCreated ChatRoom[] @relation("ChatRoomCreator")
  chatMessageReactions ChatMessageReaction[]
  projectsCreated Project[]     @relation("ProjectCreator")
  tasksCreated    ProjectTask[] @relation("TaskCreator")
  chatMessages    ChatMessage[]
  passwordResetTokens PasswordResetToken[]
  loginEvents LoginEvent[]
  blocksCreated UserBlock[] @relation("UserBlocks")
  blocksReceived UserBlock[] @relation("UserBlockedBy")
}

model UserBlock {
  id         Int      @id @default(autoincrement())
  blockerId  Int
  blocker    User     @relation("UserBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId  Int
  blocked    User     @relation("UserBlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(64)
  title     String
  body      String?
  link      String?
  meetingId Int?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// -----------------------------
// Chat (v1)
// -----------------------------

model ChatRoom {
  id        Int      @id @default(autoincrement())
  roomKey   String   @unique @db.VarChar(80)
  kind      String   @db.VarChar(16) // "MEETING" | "PROJECT"
  title     String?

  createdById Int?
  creator     User?  @relation("ChatRoomCreator", fields: [createdById], references: [id], onDelete: SetNull)

  meetingId Int?
  meeting   Meeting? @relation("MeetingChatRooms", fields: [meetingId], references: [id], onDelete: Cascade)

  projectId Int?
  project   Project? @relation("ProjectChatRooms", fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  pinnedMessageId Int? @unique
  pinnedMessage   ChatMessage? @relation("RoomPinnedMessage", fields: [pinnedMessageId], references: [id], onDelete: SetNull)

  members  ChatRoomMember[]
  messages ChatMessage[]

  @@index([kind])
}

model ChatRoomMember {
  id          Int      @id @default(autoincrement())
  roomId      Int
  room        ChatRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt  DateTime?
  /** Hide room from main list until unarchived. */
  archivedAt  DateTime?
  /** Messages at or before this time are hidden for this member (clear chat for me). */
  clearedBeforeAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([roomId, userId])
  @@index([userId, lastReadAt])
  @@index([userId, archivedAt])
}

model ChatMessage {
  id        Int       @id @default(autoincrement())
  roomId    Int
  room      ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  Int
  sender    User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body      String
  editedAt  DateTime?
  deletedAt DateTime?
  attachmentUrl   String?
  attachmentKind  String?  @db.VarChar(16)
  attachmentName  String?  @db.VarChar(255)
  attachmentSize  Int?
  createdAt DateTime  @default(now())

  replyToId Int?
  replyTo   ChatMessage? @relation("MessageReply", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   ChatMessage[] @relation("MessageReply")

  pinnedInRoom ChatRoom? @relation("RoomPinnedMessage")

  reactions ChatMessageReaction[]

  @@index([roomId, createdAt])
  @@index([replyToId])
}

model ChatMessageReaction {
  id        Int         @id @default(autoincrement())
  messageId Int
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String      @db.VarChar(32)
  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

model LoginEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success   Boolean  @default(true)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  logoutAt  DateTime?

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/** Singleton row `id = 1`: editable About page copy (admin-managed). */
model AboutPage {
  id        Int      @id
  payload   Json
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
  DIRECTOR
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum ProjectKind {
  GENERAL
  MMF
  YPA
}

model Project {
  id          Int             @id @default(autoincrement())
  code        String          @unique @db.VarChar(40)
  name        String
  description String?
  status      ProjectStatus   @default(PLANNING)
  priority    ProjectPriority @default(MEDIUM)
  projectKind ProjectKind     @default(GENERAL)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  budgetSpent Float?
  budgetCurrency String         @default("EUR")
  leaderDirectorId Int?
  leaderDirector   Director?   @relation("ProjectLeader", fields: [leaderDirectorId], references: [id])
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  createdById Int
  creator     User            @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  chatRooms ChatRoom[] @relation("ProjectChatRooms")

  tasks     ProjectTask[]
  mmfEntries MMFEntry[]
}

model ProjectTask {
  id                 Int             @id @default(autoincrement())
  projectId          Int
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  status             TaskStatus      @default(TODO)
  priority           ProjectPriority @default(MEDIUM)
  dueDate            DateTime?
  assigneeDirectorId Int?
  assignee           Director?       @relation(fields: [assigneeDirectorId], references: [id])
  sortOrder          Int             @default(0)
  estimatedCost      Float?
  actualCost         Float?
  completedAt        DateTime?
  createdById        Int
  creator            User            @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Transaction {
  id          Int       @id @default(autoincrement())
  type        TxType
  date        DateTime
  amount      Float
  description String?
  directorId  Int?
  director    Director? @relation(fields: [directorId], references: [id])
  createdBy   Int
  createdAt   DateTime  @default(now())
}

enum TxType {
  CONTRIBUTION
  SIDE_FUND
  MMF_DEPLOY
  MMF_RETURN
  YPA_INVEST
  REGISTRATION
  TX_CHARGE
  LEGAL
  PENALTY
  LOAN_IN
  OTHER_OUT
  CAPITAL_WITHDRAWAL
  INVESTMENT_RETURN
  PROJECT_REVENUE
  INTEREST_INCOME
  DIVIDEND_INCOME
  OTHER_INCOME
  PROJECT_DISBURSEMENT
  ASSET_PURCHASE
  LOAN_REPAYMENT_RECEIVED
  TRANSPORT_TRAVEL
  COMMUNICATION_INTERNET
  OFFICE_ADMINISTRATION
  PRINTING_STATIONERY
  SALARIES_WAGES
  UTILITIES
  INSURANCE
  MEALS_ENTERTAINMENT
  DIRECTOR_LOAN_TO_COMPANY
  DIRECTOR_LOAN_REPAYMENT
  LOAN_REPAYMENT_EXTERNAL
  WITHHOLDING_TAX
  VAT_PAYABLE
  CORPORATE_TAX_PROVISION
  FOREIGN_EXCHANGE_GAIN
  FOREIGN_EXCHANGE_LOSS
  LOAN_ADVANCED
}

model MMFEntry {
  id           Int      @id @default(autoincrement())
  directorId   Int
  projectId    Int?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  month        String
  principal    Float
  interest     Float
  interestRate Float
  accountType  String
  notes        String?
  createdAt    DateTime @default(now())
}

model CirculationRound {
  id              Int      @id @default(autoincrement())
  round           Int
  position        Int
  startDate       DateTime
  endDate         DateTime
  recipientId     Int
  approved        Boolean  @default(false)
  amountPerMember Float
  totalCollected  Float?
  notes           String?
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  entityType String
  entityId   Int?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
}

model Meeting {
  id               Int      @id @default(autoincrement())
  title            String
  date             String
  time             String?
  location         String?
  chairperson      String?
  attendees        String?
  attendanceCount  Int?
  expectedAttendees Int?
  meetingType      String?  @default("Board")
  priority         String?  @default("Medium")
  recurrence       String?  @default("NONE")
  reminderDays     Int?
  agenda           String?
  actionItems      String?
  notes            String?
  nextMeetingDate  String?
  status           String   @default("SCHEDULED")
  createdById      Int?
  updatedById      Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reminderSent MeetingReminderSent?

  chatRooms ChatRoom[] @relation("MeetingChatRooms")

  @@index([date])
  @@index([status])
}

/** One row per meeting after the reminder email has been sent (idempotent). */
model MeetingReminderSent {
  id        Int      @id @default(autoincrement())
  meetingId Int      @unique
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sentAt    DateTime @default(now())
}

model DocumentRegister {
  id              Int      @id @default(autoincrement())
  title           String
  category        String   @default("Governance")
  reference       String?
  owner           String?
  confidentiality String   @default("Internal")
  status          String   @default("ACTIVE")
  version         String?  @default("1.0")
  tags            String?
  effectiveDate   String?
  reviewDate      String?
  expiryDate      String?
  pinned          Boolean  @default(false)
  url             String?
  notes           String?
  createdById     Int?
  updatedById     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model ReconciliationNote {
  id               Int      @id @default(autoincrement())
  periodFrom       String
  statementDate    String
  notes            String?
  clearedMap       Json?
  createdById      Int?
  updatedById      Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([periodFrom, statementDate])
}

