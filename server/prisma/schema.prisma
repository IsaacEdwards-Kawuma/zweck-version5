generator client {
  provider = "prisma-client-js"
}

// Use Neon, local Postgres, or any Postgres. Neon: append ?sslmode=require to DATABASE_URL.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Director {
  id          Int       @id @default(autoincrement())
  name        String
  initials    String    @db.VarChar(3)
  email       String    @unique
  phone       String?
  idNumber    String?
  occupation  String?
  address     String?
  nextOfKinName  String?
  nextOfKinPhone String?
  notes       String?
  avatarUrl   String?
  joinedRound Int       @default(1)
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  transactions Transaction[]
  user         User?
  assignedTasks ProjectTask[]
  ledProjects   Project[]     @relation("ProjectLeader")
}

model User {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  password   String
  role       Role      @default(USER)
  directorId Int?      @unique
  director   Director? @relation(fields: [directorId], references: [id])
  lastLoginAt DateTime?
  /** When true, user may receive meeting reminder emails (admins, directors, and meeting creator). */
  emailMeetingReminders Boolean @default(true)
  /** When true, user receives in-app notifications for meeting reminders (same audience rules as email). */
  inAppMeetingReminders Boolean @default(true)
  createdAt  DateTime  @default(now())

  notifications Notification[]
  projectsCreated Project[]     @relation("ProjectCreator")
  tasksCreated    ProjectTask[] @relation("TaskCreator")
  passwordResetTokens PasswordResetToken[]
  loginEvents LoginEvent[]
}

model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    @db.VarChar(64)
  title     String
  body      String?
  link      String?
  meetingId Int?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model LoginEvent {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  success   Boolean  @default(true)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
  logoutAt  DateTime?

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.VarChar(64)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

/** Singleton row `id = 1`: editable About page copy (admin-managed). */
model AboutPage {
  id        Int      @id
  payload   Json
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  USER
  DIRECTOR
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum ProjectKind {
  GENERAL
  MMF
  YPA
}

model Project {
  id          Int             @id @default(autoincrement())
  code        String          @unique @db.VarChar(40)
  name        String
  description String?
  status      ProjectStatus   @default(PLANNING)
  priority    ProjectPriority @default(MEDIUM)
  projectKind ProjectKind     @default(GENERAL)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  budgetSpent Float?
  budgetCurrency String         @default("EUR")
  leaderDirectorId Int?
  leaderDirector   Director?   @relation("ProjectLeader", fields: [leaderDirectorId], references: [id])
  contactName   String?
  contactEmail  String?
  contactPhone  String?
  createdById Int
  creator     User            @relation("ProjectCreator", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tasks     ProjectTask[]
  mmfEntries MMFEntry[]
}

model ProjectTask {
  id                 Int             @id @default(autoincrement())
  projectId          Int
  project            Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title              String
  description        String?
  status             TaskStatus      @default(TODO)
  priority           ProjectPriority @default(MEDIUM)
  dueDate            DateTime?
  assigneeDirectorId Int?
  assignee           Director?       @relation(fields: [assigneeDirectorId], references: [id])
  sortOrder          Int             @default(0)
  estimatedCost      Float?
  actualCost         Float?
  completedAt        DateTime?
  createdById        Int
  creator            User            @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model Transaction {
  id          Int       @id @default(autoincrement())
  type        TxType
  date        DateTime
  amount      Float
  description String?
  directorId  Int?
  director    Director? @relation(fields: [directorId], references: [id])
  createdBy   Int
  createdAt   DateTime  @default(now())
}

enum TxType {
  CONTRIBUTION
  SIDE_FUND
  MMF_DEPLOY
  MMF_RETURN
  YPA_INVEST
  REGISTRATION
  TX_CHARGE
  LEGAL
  PENALTY
  LOAN_IN
  OTHER_OUT
}

model MMFEntry {
  id           Int      @id @default(autoincrement())
  directorId   Int
  projectId    Int?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  month        String
  principal    Float
  interest     Float
  interestRate Float
  accountType  String
  notes        String?
  createdAt    DateTime @default(now())
}

model CirculationRound {
  id              Int      @id @default(autoincrement())
  round           Int
  position        Int
  startDate       DateTime
  endDate         DateTime
  recipientId     Int
  approved        Boolean  @default(false)
  amountPerMember Float
  totalCollected  Float?
  notes           String?
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  action     String
  entityType String
  entityId   Int?
  before     Json?
  after      Json?
  createdAt  DateTime @default(now())
}

model Meeting {
  id               Int      @id @default(autoincrement())
  title            String
  date             String
  time             String?
  location         String?
  chairperson      String?
  attendees        String?
  attendanceCount  Int?
  expectedAttendees Int?
  meetingType      String?  @default("Board")
  priority         String?  @default("Medium")
  recurrence       String?  @default("NONE")
  reminderDays     Int?
  agenda           String?
  actionItems      String?
  notes            String?
  nextMeetingDate  String?
  status           String   @default("SCHEDULED")
  createdById      Int?
  updatedById      Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  reminderSent MeetingReminderSent?

  @@index([date])
  @@index([status])
}

/** One row per meeting after the reminder email has been sent (idempotent). */
model MeetingReminderSent {
  id        Int      @id @default(autoincrement())
  meetingId Int      @unique
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sentAt    DateTime @default(now())
}

model DocumentRegister {
  id              Int      @id @default(autoincrement())
  title           String
  category        String   @default("Governance")
  reference       String?
  owner           String?
  confidentiality String   @default("Internal")
  status          String   @default("ACTIVE")
  version         String?  @default("1.0")
  tags            String?
  effectiveDate   String?
  reviewDate      String?
  expiryDate      String?
  pinned          Boolean  @default(false)
  url             String?
  notes           String?
  createdById     Int?
  updatedById     Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model ReconciliationNote {
  id               Int      @id @default(autoincrement())
  periodFrom       String
  statementDate    String
  notes            String?
  clearedMap       Json?
  createdById      Int?
  updatedById      Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([periodFrom, statementDate])
}

