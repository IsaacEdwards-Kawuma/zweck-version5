{
  "openapi": "3.0.3",
  "info": {
    "title": "ZweckOS API",
    "description": "Internal accounting and operations API. Authenticated routes except `/auth/login`, `/auth/register`, `/auth/forgot-password`, `/auth/reset-password`, `/health`, `/docs`, `/openapi.json`. Scheduled jobs under `/jobs/*` use `CRON_SECRET` (header `X-Cron-Secret` or `Authorization: Bearer`), not JWT.",
    "version": "1.0.0"
  },
  "servers": [{ "url": "/api", "description": "Relative to API origin" }],
  "tags": [
    { "name": "health" },
    { "name": "auth" },
    { "name": "transactions" },
    { "name": "accounts" },
    { "name": "directors" },
    { "name": "portfolio" },
    { "name": "projects" },
    { "name": "users" },
    { "name": "audit" },
    { "name": "settings" },
    { "name": "search" },
    { "name": "admin" },
    { "name": "about-page" },
    { "name": "meetings" },
    { "name": "integrations" },
    { "name": "jobs" }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "cronSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Cron-Secret"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": { "type": "boolean" },
          "message": { "type": "string" },
          "field": { "type": "string" }
        }
      },
      "LoginBody": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "format": "email" },
          "password": { "type": "string" }
        }
      },
      "LoginResponse": {
        "type": "object",
        "properties": { "token": { "type": "string" } }
      }
    }
  },
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "avatarStorage": { "type": "string", "enum": ["local", "s3"] }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Sign in",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/LoginBody" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT token",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/LoginResponse" }
              }
            }
          },
          "401": { "description": "Invalid credentials" }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["auth"],
        "summary": "Request password reset email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["email"],
                "properties": { "email": { "type": "string", "format": "email" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Generic success (does not reveal whether email exists)"
          }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["auth"],
        "summary": "Set new password with token from email",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["token", "password"],
                "properties": {
                  "token": { "type": "string" },
                  "password": { "type": "string", "minLength": 8 }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Password updated" },
          "400": { "description": "Invalid or expired token" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["auth"],
        "summary": "Current user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User profile" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/auth/me/data-export": {
      "get": {
        "tags": ["auth"],
        "summary": "Personal data export (JSON)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "User, director profile, recent director transactions" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/auth/me/erasure-request": {
      "post": {
        "tags": ["auth"],
        "summary": "Record GDPR-style erasure request",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": { "notes": { "type": "string", "maxLength": 2000 } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Request recorded" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/transactions": {
      "get": {
        "tags": ["transactions"],
        "summary": "List transactions (paginated)",
        "description": "Returns items, total, limit, offset, and aggregates (sum/count/avg/byType) for the filter. Omit limit for up to 100k rows.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "from", "in": "query", "schema": { "type": "string" } },
          { "name": "to", "in": "query", "schema": { "type": "string" } },
          { "name": "type", "in": "query", "schema": { "type": "string" } },
          { "name": "directorId", "in": "query", "schema": { "type": "integer" } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "maximum": 100000 } },
          { "name": "offset", "in": "query", "schema": { "type": "integer", "minimum": 0 } }
        ],
        "responses": { "200": { "description": "Paginated list with aggregates" } }
      },
      "post": {
        "tags": ["transactions"],
        "summary": "Create transaction",
        "security": [{ "bearerAuth": [] }],
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/accounts": {
      "get": {
        "tags": ["accounts"],
        "summary": "Chart of accounts / balances",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/directors": {
      "get": {
        "tags": ["directors"],
        "summary": "List directors",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/portfolio": {
      "get": {
        "tags": ["portfolio"],
        "summary": "Portfolio summary",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/projects": {
      "get": {
        "tags": ["projects"],
        "summary": "List projects",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      },
      "post": {
        "tags": ["projects"],
        "summary": "Create project",
        "security": [{ "bearerAuth": [] }],
        "responses": { "201": { "description": "Created" } }
      }
    },
    "/users": {
      "get": {
        "tags": ["users"],
        "summary": "List users (admin)",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/audit": {
      "get": {
        "tags": ["audit"],
        "summary": "Audit log (admin)",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/settings": {
      "get": {
        "tags": ["settings"],
        "summary": "Settings / monitoring summary (authenticated)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "Version, uptime, monitoring flags, rate limits. `session` includes `emailMeetingReminders` (boolean)."
          }
        }
      }
    },
    "/settings/notifications": {
      "patch": {
        "tags": ["settings"],
        "summary": "Update email notification preferences",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["emailMeetingReminders"],
                "properties": {
                  "emailMeetingReminders": {
                    "type": "boolean",
                    "description": "When true, eligible users may receive meeting reminder emails (admins, directors, meeting creator)."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated preference",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": { "emailMeetingReminders": { "type": "boolean" } }
                }
              }
            }
          },
          "400": { "description": "Invalid body" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/jobs/meeting-reminders": {
      "post": {
        "tags": ["jobs"],
        "summary": "Run meeting reminder email job (scheduler)",
        "description": "Call daily from a cron or external scheduler. Not for browser use. Requires `CRON_SECRET` on the server; send the same value in `X-Cron-Secret` or as `Authorization: Bearer <secret>`.",
        "security": [{ "cronSecret": [] }],
        "responses": {
          "200": {
            "description": "Job result counts",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "checked": { "type": "integer" },
                    "sent": { "type": "integer" },
                    "skipped": { "type": "integer" },
                    "errors": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          },
          "401": { "description": "Missing or wrong secret" },
          "503": { "description": "`CRON_SECRET` not configured on server" },
          "500": { "description": "Job failed" }
        }
      }
    },
    "/search": {
      "get": {
        "tags": ["search"],
        "summary": "Search directors, meetings, documents",
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 2 } }],
        "responses": {
          "200": { "description": "Grouped hits" },
          "400": { "description": "Query too short" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/admin/export": {
      "get": {
        "tags": ["admin"],
        "summary": "Organisation JSON backup (admin)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "JSON attachment" },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/meetings/calendar.ics": {
      "get": {
        "tags": ["meetings"],
        "summary": "Meetings as iCalendar feed",
        "description": "Returns text/calendar; cancelled meetings are omitted. Requires authentication.",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": {
            "description": "iCalendar (.ics) document",
            "content": {
              "text/calendar": {
                "schema": { "type": "string", "format": "binary" }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/integrations/ping": {
      "post": {
        "tags": ["integrations"],
        "summary": "Integration test ping (admin)",
        "description": "Records request body in audit log as INTEGRATION_PING (no other side effects).",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "type": "object", "additionalProperties": true }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Acknowledged",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "receivedAt": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "403": { "description": "Forbidden" }
        }
      }
    },
    "/about-page": {
      "get": {
        "tags": ["about-page"],
        "summary": "About page content",
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "payload + isCustom" } }
      },
      "put": {
        "tags": ["about-page"],
        "summary": "Replace About page (admin)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Saved" },
          "403": { "description": "Forbidden" }
        }
      },
      "delete": {
        "tags": ["about-page"],
        "summary": "Reset About page to defaults (admin)",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "Defaults restored" },
          "403": { "description": "Forbidden" }
        }
      }
    }
  }
}
