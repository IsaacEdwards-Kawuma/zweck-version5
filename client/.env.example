# Local dev — leave VITE_API_URL unset: the app uses same-origin `/api` and Vite proxies to localhost:3001
# (see vite.config.js). Start the API: cd server && npm run dev
#
# VITE_API_URL=https://your-service.onrender.com/api
#   ^ optional: call your Render API directly from the dev machine (HTTPS)

# --- Vercel (production) — Project → Settings → Environment Variables ---
# RENDER_API_URL=https://your-service.onrender.com
#   ^ no trailing slash, no /api — required for the Edge proxy (client/api/[...path].js)
# Do NOT set VITE_API_URL to http://localhost:3001 on Vercel. Remove it or use the HTTPS Render URL above.
