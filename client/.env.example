# Local — copy to client/.env
VITE_API_URL="http://localhost:3001/api"

# Production (Vercel Environment Variables) — your Render API base + /api
# VITE_API_URL=https://YOUR-SERVICE.onrender.com/api
#
# IMPORTANT: Do NOT use http://localhost:3001 on Vercel. The site is HTTPS; calling http://localhost
# is blocked as mixed content (DevTools: CORS failed / status null). Use your Render HTTPS URL.

