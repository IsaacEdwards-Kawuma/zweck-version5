# =============================================================================
# ZWECKOS — deployment environment template
#
# 1. Copy this file:  copy deploy.env.example  →  deploy.env  (or any name)
# 2. Replace every CHANGE_ME / https://... placeholder with your real values
# 3. Paste variables into each platform (do not commit deploy.env with secrets)
#
# RENDER  → Web Service, Root Directory: server
# VERCEL  → Project, Root Directory: client (recommended)
#           If Root Directory is empty (repo root), Vercel uses root vercel.json + api/[...path].js
# =============================================================================

# -----------------------------------------------------------------------------
# RENDER — API (paste these in Render → your service → Environment)
# -----------------------------------------------------------------------------

NODE_ENV=production

# Neon / Postgres (must include ssl for hosted DB)
DATABASE_URL=CHANGE_ME_postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# openssl rand -hex 32
JWT_SECRET=CHANGE_ME_long_random_string

# Your Vercel app URL(s), comma-separated, no spaces after commas
ALLOWED_ORIGINS=https://CHANGE_ME-your-app.vercel.app

# Optional: single canonical frontend origin (CORS / fallbacks)
CLIENT_ORIGIN=https://CHANGE_ME-your-app.vercel.app

# Optional: allow all *.vercel.app preview deployments
ALLOW_VERCEL_PREVIEWS=true

# Password-reset links in emails — same as your public Vercel URL
PUBLIC_APP_URL=https://CHANGE_ME-your-app.vercel.app

# --- SMTP (Render ONLY — do not add these on Vercel; the API sends mail, not the frontend) ---
# Add one row per variable in Render → Environment (Key = left column, Value = right).
# Use a plain email for SMTP_FROM (no spaces, no <angle brackets>) — avoids dashboard parse errors.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@yourdomain.com

# --- If you see "Environment variable keys must consist of alphabetic..." ---
# You pasted invalid text into the KEY (name) field: comment lines (#...), quotes around the key,
# "export KEY=value", or multiple lines at once. Add SMTP_HOST, SMTP_PORT, etc. as separate keys
# with ONLY letters/numbers/underscore (SMTP_FROM is valid). Put the secret in Value only.

# Optional — server error monitoring
# SENTRY_DSN=https://CHANGE_ME@o....ingest.sentry.io/...

# Optional — director avatars on S3 / R2 (set all or none)
# S3_BUCKET=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=
# S3_ENDPOINT=

# Optional — logging: debug | info | warn | error | silent
# LOG_LEVEL=info

# -----------------------------------------------------------------------------
# VERCEL — frontend (paste these in Vercel → Project → Settings → Environment Variables)
# -----------------------------------------------------------------------------

# Render API base URL only: no /api, no trailing slash
# Example: https://zweckos-api.onrender.com
RENDER_API_URL=https://CHANGE_ME-your-api.onrender.com

# Leave VITE_API_URL unset on Vercel (same-origin /api via proxy). If you set VITE_API_URL to Render,
# the client still uses /api unless VITE_API_DIRECT=true (direct browser→Render needs CORS on Render).

# Optional — browser Sentry (client-side errors)
# VITE_SENTRY_DSN=https://CHANGE_ME@o....ingest.sentry.io/...

# -----------------------------------------------------------------------------
# LOCAL DEV (optional — use server/.env and client/.env instead of this file)
# -----------------------------------------------------------------------------
#
# server/.env  → DATABASE_URL, JWT_SECRET, PORT=3001, ALLOWED_ORIGINS for localhost
# client/.env  → usually empty; Vite proxies /api to the server
#
